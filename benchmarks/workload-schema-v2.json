{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qwen-mm-benchmark-workload-v2",
  "type": "object",
  "required": ["schema_version", "schema_id", "cases"],
  "properties": {
    "schema_version": {"const": 2},
    "schema_id": {"const": "qwen-mm-benchmark-workload-v2"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "case_id", "boundary", "layout", "source", "cache_mode",
          "float_atol", "tags"
        ],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "release_name": {"type": "string"},
          "boundary": {
            "enum": [
              "structured_messages_to_numpy",
              "encoded_to_numpy",
              "rgb_to_vllm_ready"
            ]
          },
          "layout": {"enum": ["text", "one_request", "independent_requests"]},
          "source": {"type": "object", "required": ["kind"]},
          "cache_mode": {"enum": ["disabled", "enabled", "separated"]},
          "float_atol": {"type": "number", "minimum": 0},
          "tags": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
