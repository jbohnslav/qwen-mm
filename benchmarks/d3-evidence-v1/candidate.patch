+    let (means, stds) = fused_normalization_constants(visual);
+    let mut normalized = [[0.0_f32; 256]; 3];
+    for channel in 0..3 {
+        for value in 0_u8..=u8::MAX {
+            normalized[channel][usize::from(value)] =
+                (f32::from(value) - means[channel]) / stds[channel];
+        }
+    }
